# Dependencies
node_modules/

# Build output
# dist/src is the committed runtime output for the TypeScript/dist topology.
# Type declarations are local build/typecheck byproducts, not runtime output.
/dist/src/*.d.ts
/dist/src/**/*.d.ts
# Local release and development plugin bundles remain transient.
/dist/release/
/dist/claude-plugin/
build/
out/

# Environment
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

