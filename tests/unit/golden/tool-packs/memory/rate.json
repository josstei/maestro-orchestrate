{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "enum": [
        "phase",
        "session"
      ],
      "description": "Rating scope: a single phase or the whole session."
    },
    "session_id": {
      "type": "string"
    },
    "phase_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Required when target is phase."
    },
    "rating": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "target",
    "session_id",
    "rating"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
